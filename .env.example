PORT=3001
WEB_ORIGIN=http://localhost:3000
VITE_API_BASE_URL=/api

# JWT e sessao
AUTH_JWT_SECRET=change-this-secret-before-production
AUTH_SESSION_TTL_SECONDS=604800
AUTH_COOKIE_NAME=lumiar_flow_session
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_SECURE=false

# Sentry
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_RELEASE=

# Admin inicial
BOOTSTRAP_ADMIN_NAME=Melina Abreu
BOOTSTRAP_ADMIN_EMAIL=melina@powercrm.com.br
BOOTSTRAP_ADMIN_PASSWORD=change-this-admin-password

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_SCHEMA=public

# Opcional para despliegue separado
# VITE_API_BASE_URL=https://api.lumiarflow.com.br
# WEB_ORIGIN=https://app.lumiarflow.com.br
# AUTH_COOKIE_SAMESITE=none
# AUTH_COOKIE_SECURE=true
